# Google Analytics 4 Measurement ID (optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Production site URL for metadata
# NEXT_PUBLIC_SITE_URL=https://elizabethpeeling.ca

# --- Ads Studio ( /studio ) ---
# Password for the private creative studio login
STUDIO_PASSWORD=your-secure-studio-password

# Optional: separate signing secret for studio_session cookies (defaults to STUDIO_PASSWORD)
# STUDIO_SESSION_SECRET=

# Caption generation (optional — uses template captions when unset)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Meta / Facebook / Instagram publishing (server-side)
# META_PAGE_ACCESS_TOKEN=
# FACEBOOK_PAGE_ID=
# INSTAGRAM_BUSINESS_ACCOUNT_ID=
# META_GRAPH_VERSION=v21.0
