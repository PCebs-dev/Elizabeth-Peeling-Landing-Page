# Google Analytics 4 Measurement ID (optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Production site URL for metadata
# NEXT_PUBLIC_SITE_URL=https://elizabethpeeling.ca

# --- Ads Studio (private /studio) ---
# Required to log in to the Social Ads Studio
STUDIO_PASSWORD=change-me-to-a-strong-password

# OpenAI key for AI ad copy + AI image creatives
# Required for "Generate AI creative"; optional for "Generate ad" (falls back to templates)
# OPENAI_API_KEY=sk-...

# Optional model overrides
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_IMAGE_MODEL=gpt-image-2
# (dall-e-3 was removed from the OpenAI API; studio tries gpt-image-2 → 1.5 → 1 → mini, then a free fallback)

# V1 video voiceover / V2 talking-head speech (OpenAI TTS)
# Reuses OPENAI_API_KEY. Optional overrides:
# OPENAI_TTS_MODEL=tts-1
# OPENAI_TTS_VOICE=coral
# Studio Video prep also lets you pick Female/Male/Neutral voices and Test voice.
# Mux (V1 only) requires ffmpeg on the machine running `next dev` (not typical Vercel serverless).
# Windows: winget install Gyan.FFmpeg  then restart the terminal / dev server
# Or set an absolute path:
# FFMPEG_PATH=C:\path\to\ffmpeg.exe

# Higgsfield (AI video / image-to-video for Reels-style clips)
# Create keys at https://cloud.higgsfield.ai/ — Key ID + Secret
# HIGGSFIELD_API_KEY_ID=
# HIGGSFIELD_API_KEY_SECRET=
# Optional model override (default higgsfield-ai/dop/standard)
# HIGGSFIELD_VIDEO_MODEL=higgsfield-ai/dop/standard

# V2 talking head (Sync Labs lip-sync)
# Create a key at https://sync.so/settings/api-keys
# SYNC_API_KEY=
# Optional model (default lipsync-2). Alternatives: lipsync-2-pro, react-1
# For react-1, studio sets model_mode=head for expressive talking-head motion.
# SYNC_MODEL=lipsync-2

# Daily calendar automation
# Local (unpublished): Windows Task Scheduler runs `npm run studio:calendar-daily`
# at 7:00 AM — no Next.js server and no Vercel required. Logs: logs/calendar-daily.log
# Optional HTTP runner (needs next dev + secret): npm run studio:calendar-daily-http
# STUDIO_AUTOMATION_SECRET=change-me-long-random-string
# CRON_SECRET=change-me-long-random-string
# STUDIO_BASE_URL=http://localhost:3000

# --- Meta publish (Facebook Page + Instagram Business) ---
# Create a Meta app, connect your Facebook Page + Instagram Business account,
# then generate a long-lived Page access token with:
# pages_manage_posts, pages_read_engagement, pages_show_list,
# instagram_basic, instagram_content_publish
# META_PAGE_ID=your-facebook-page-id
# META_PAGE_ACCESS_TOKEN=your-long-lived-page-access-token
# META_IG_USER_ID=your-instagram-business-account-id
# Optional Graph API version (default v21.0)
# META_GRAPH_VERSION=v21.0

# Auto-publish calendar Story creatives to IG + FB Stories.
# Default is OFF — daily cron saves ads for review; publish manually from /studio.
# Set true later when you want Stories to go live automatically.
# STUDIO_AUTO_PUBLISH_STORIES=false
# Optional: which Stories platforms (default both when configured)
# STUDIO_STORY_PLATFORMS=instagram,facebook
