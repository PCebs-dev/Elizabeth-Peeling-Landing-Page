# Public URL for metadata (optional)
# NEXT_PUBLIC_SITE_URL=https://studio.elizabethpeeling.ca

# Required — private studio login password
STUDIO_PASSWORD=your-secure-studio-password

# Optional: separate signing secret for studio_session cookies
# STUDIO_SESSION_SECRET=

# Recommended — photos persist across devices (Vercel Blob)
# BLOB_READ_WRITE_TOKEN=

# Caption generation (optional — template captions when unset)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Social publishing
# META_PAGE_ACCESS_TOKEN=
# FACEBOOK_PAGE_ID=
# INSTAGRAM_BUSINESS_ACCOUNT_ID=
# META_GRAPH_VERSION=v21.0
